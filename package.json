{
  "name": "context-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Local web app to visualize Claude Code, OpenCode, and Codex session context.",
  "license": "GPL-3.0-or-later",
  "bin": {
    "context-visualizer": "scripts/cli.ts"
  },
  "scripts": {
    "dev": "bun scripts/cli.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "cd web && bun run dev",
    "build:web": "cd web && bun run build",
    "start": "bun server/index.ts"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.20"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
